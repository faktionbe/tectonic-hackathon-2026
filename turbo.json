{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "agents#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".mastra/output/**"]
    },
    "py-api#build": {
      "outputs": []
    },
    "py-contracts#build": {
      "outputs": []
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "@repo/shared#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "@repo/openapi#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "@repo/contracts#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "@repo/kbc-products#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "@repo/database#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build", "^build"]
    },
    "format": {
      "cache": false,
      "persistent": true
    }
  }
}

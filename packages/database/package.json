{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsup src/index.ts",
    "dev": "npm run build",
    "lint": "eslint .",
    "format": "prisma format",
    "seed-dev": "prisma migrate reset --force && tsx --env-file=.env prisma/seed-dev.ts",
    "seed-prod": "tsx prisma/seed-prod.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:personas": "pnpm --filter @repo/contracts build && prisma generate && tsx --env-file=.env prisma/seed-personas.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@repo/shared": "workspace:*",
    "argon2": "^0.43.0",
    "prisma": "^7.8.0",
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.21.0"
  }
}

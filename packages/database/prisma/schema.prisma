  whenZ          DateTime? @default(now()) @db.Timestamptz(6)
  deletedAtZ     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([node, id(sort: Desc)], map: "idx_knowledge_records_node_latest")
  @@index([sourceThreadId, id(sort: Desc)], map: "idx_knowledge_records_thread_latest")
}


  availableAtZ   DateTime? @default(now()) @db.Timestamptz(6)
  claimedAtZ     DateTime? @default(now()) @db.Timestamptz(6)
  createdAtZ     DateTime? @default(now()) @db.Timestamptz(6)
  completedAtZ   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([status, availableAt, createdAt], map: "idx_knowledge_outbox_claim")
}


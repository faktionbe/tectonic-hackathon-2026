{
  "name": "@repo/openapi",
  "version": "1.0.0",
  "description": "Library that contains OpenAPI schema converter for Zod",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@nestjs/swagger": "^12.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/swagger": "^12.0.2",
    "zod": "^4.6.5"
  }
}

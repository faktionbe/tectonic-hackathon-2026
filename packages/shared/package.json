    "format": "prettier --write ."
  },
  "dependencies": {
    "lodash.groupby": "^4.6.0",
    "lodash.keyby": "^4.6.0",
    "lodash.uniq": "^4.5.0"
  },
  "devDependencies": {
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.keyby": "^4.6.9",
    "@types/lodash.uniq": "^4.5.9"
  }
}

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tectonic
OPENROUTER_API_KEY=
# Shared with apps/server M2M_JWT — Authorization: Bearer for Nest API calls
M2M_JWT=
# Nest API base URL including the /api prefix
SERVER_API_URL=http://localhost:4000/api
# Origin of this Mastra server. Kate calls the savings agent over A2A here.
A2A_BASE_URL=http://127.0.0.1:4111
# Used when a chat request does not include requestContext.profileId.
DEFAULT_PROFILE_ID=dummy-profile
